# ── Alpaca Paper Trading ───────────────────────────────────────────────────────
# Sign up at https://alpaca.markets — use the Paper Trading environment keys.
# NEVER use live keys here. The agent enforces paper-only mode in code.
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here
# Leave this as the paper endpoint — do NOT change to live without reading the
# LIVE_TRADING_WARNING in agent/broker/base.py
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Model used for the reasoning layer. Update when newer models are available.
CLAUDE_MODEL=claude-sonnet-4-6

# ── Trading Universe ──────────────────────────────────────────────────────────
# Comma-separated list of crypto symbols (Alpaca format: BTC/USD, ETH/USD, etc.)
TRADING_UNIVERSE=BTC/USD,ETH/USD,SOL/USD,AVAX/USD,MATIC/USD,LINK/USD,DOT/USD,ADA/USD

# ── Risk Parameters ───────────────────────────────────────────────────────────
# These are defaults; hard caps are enforced in agent/risk/checks.py regardless.
MAX_RISK_PER_TRADE_PCT=0.02      # 2% max portfolio risk per trade
MAX_POSITION_PCT=0.10            # 10% max in a single asset
MAX_OPEN_POSITIONS=5             # Max concurrent open positions
DAILY_LOSS_LIMIT_PCT=0.05        # -5% daily drawdown triggers circuit breaker

# ── Scheduler ────────────────────────────────────────────────────────────────
TRADING_LOOP_SECONDS=300         # How often the main loop runs (5 min default)
REFLECTION_HOUR=23               # Hour (UTC) the nightly reflection job runs

# ── Storage ──────────────────────────────────────────────────────────────────
DB_PATH=data/trader.db
PARQUET_DIR=data/parquet
LOG_LEVEL=INFO

# ── Dashboard ────────────────────────────────────────────────────────────────
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000

# ── Feature Flags ─────────────────────────────────────────────────────────────
# DANGER: LIVE_TRADING_ENABLED must remain False. Enabling requires:
#   1. Change to True here AND in agent/broker/base.py (hard-coded guard)
#   2. Set LIVE_TRADING_SECRET to a specific value (see base.py)
#   3. Swap ALPACA_BASE_URL to live endpoint
#   4. Accept full legal and financial responsibility
LIVE_TRADING_ENABLED=False
DRY_RUN=True                         # True = log decisions only, no orders placed

# ── Reproducibility ───────────────────────────────────────────────────────────
RANDOM_SEED=42
